    "# Scenario 2: Multilingual Entity Handling\n",
    "print(\"🌍 Scenario 2: Multilingual Entity Handling\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Find entities with multilingual characteristics\n",
    "multilingual_entities = []\n",
    "for entity in watch_list.entities.values():\n",
    "    # Look for entities with non-ASCII characters or multiple language indicators\n",
    "    name = entity.name\n",
    "    aliases = entity.aliases\n",
    "    \n",
    "    # Check for non-ASCII characters in name or aliases\n",
    "    has_non_ascii = any(ord(char) > 127 for char in name)\n",
    "    has_multilingual_aliases = any(ord(char) > 127 for alias in aliases for char in alias)\n",
    "    \n",
    "    if has_non_ascii or has_multilingual_aliases:\n",
    "        multilingual_entities.append(entity)\n",
    "\n",
    "if not multilingual_entities:\n",
    "    # Use entities with multiple aliases for demonstration\n",
    "    multilingual_entities = [e for e in watch_list.entities.values() if len(e.aliases) > 1][:2]\n",
    "    print(\"📋 No multilingual entities found, using entities with multiple aliases for demonstration\")\n",
    "\n",
    "print(f\"\\n🔍 Processing {len(multilingual_entities)} multilingual entities:\")\n",
    "\n",
    "for i, entity in enumerate(multilingual_entities, 1):\n",
    "    print(f\"\\n   {i}. {entity.name} ({entity.entity_type})\")\n",
    "    print(f\"      Aliases: {entity.aliases}\")\n",
    "    \n",
    "    # Enrich with multilingual support\n",
    "    print(f\"      🌐 Enriching with multilingual support...\")\n",
    "    enriched_entity = entity_enricher.enrich_entity(\n",
